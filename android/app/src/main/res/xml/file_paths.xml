<?xml version="1.0" encoding="utf-8"?>
<!--
  The paths the package installer may read.

  The helper APK is downloaded by the daemon into the app's own storage (the
  product directory), and Android's package installer cannot open a `file://`
  URI from another process — it needs a `content://` one that this app vouches
  for. This is that grant, and it covers exactly the helper directory: nothing
  else in the app's tree is exposed.
-->
<paths>
    <files-path
        name="helper"
        path="atomcode/helper/" />
    <!--
      Camera output. `ACTION_IMAGE_CAPTURE` hands the picture back through a
      `content://` URI this app must vouch for; the file itself lives in the
      cache dir so it is never mistaken for user data — the webui reads it
      once and the host deletes it.
    -->
    <cache-path
        name="captures"
        path="captures/" />
    <!--
      Files the agent produced, handed to whatever app can view them.

      The artifact chips in the webui call this app to open a path, and the only
      way to hand a file to another app since Android 7 is a `content://` URI this
      app vouches for — a `file://` one raises `FileUriExposedException`. The
      agent works in shared storage (`/storage/emulated/0/AtomCode`), so that whole
      tree is vouchable, and so are the product directory and the shared-file
      cache; nothing else is. Each URI is granted one viewer, read-only, for one
      launch — the paths here only decide what this app *can* vouch for.
    -->
    <external-path
        name="workspace"
        path="." />
    <files-path
        name="product"
        path="atomcode/" />
    <cache-path
        name="shares"
        path="shares/" />
</paths>
