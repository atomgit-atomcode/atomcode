<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. minSdk is 26, so every supported device takes this
  path — there is no legacy bitmap to ship and no `mipmap-<density>` set to
  maintain. `android:icon`/`android:roundIcon` in the manifest point here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>