# Build
/target
/runs

# npm package: build artifacts
packages/npm/*.tgz

.env/

# Git worktrees (used by superpowers:using-git-worktrees)
/.worktrees/

# OS
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Environment variables (may contain secrets)
.env

# Python (dev scripts)
__pycache__/
*.pyc
/venv/

# Web (separate frontend, not part of core)
/web/

# Node
node_modules/
**/node_modules/
package-lock.json
!extensions/vscode/package-lock.json
!tools/weixin-bridge/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temp / WIP files
site/index-new.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# Config with secrets
config.toml

# Personal project instructions (loaded by AtomCode, never committed)
.atomcode.user.md

# Logs
/datalog/
/site/datalog/
/test-report.md

# Local docs (not pushed to remote)
/doc/
backend.log
.venv-swebench/

# AtomCode local data (graph cache, etc.)
.atomcode/

# Claude Code's project instructions — kept locally for the IDE/agent that
# maintains atomcode source, but NOT pushed (it's personal guidance, may
# diverge between contributors, and shouldn't imply official project rules).
/CLAUDE.md
.claude/settings.local.json
.claude/worktrees/
# Scratch space for the local Claude session (issue scrapes, notes,
# intermediate analysis artifacts). Personal to the contributor and
# not part of the source tree.
.claude/atomcode_issues_*.json
.claude/issues_*.json
.claude/issues_*.md
.claude/open_mrs.json

# Local eval harness — kept off version control. Includes scripts,
# baseline/config TOML (may hold API keys), case inputs, run outputs,
# and sample projects. The whole directory lives on disk for reruns
# but never ships.
scripts/eval/
dist/
docs/superpowers
.mcp.json

# v2 (kernel-spike) local design specs / backlog — working docs kept on disk for
# the contributor, NEVER committed (turn-end auto-commit would otherwise sweep them).
docs/c1-assembly-spec.md
docs/mcp-capability-spec.md
docs/overflow-compaction-spec.md
docs/session-persistence-recall-spec.md
docs/system-prompt-parity-spec.md
docs/v2-port-backlog.md
# Generated crate-dependency visualization — regenerated at will, the numbers in
# it go stale the moment a Cargo.toml moves.
docs/atomcode-crate-deps.html

# Superpowers plugin state
.superpowers/
.plan_docs
extensions/vscode/resources/bin/
.kiro
# AtomCode local-scope configs (machine-specific)
.atomcode/local/
crates/atomcode-codingplan-crypto/
# 专有请求签名 crate 的本地 checkout。里面是网关签名算法与主密钥,
# 绝不能进版本库——`crates/atomcode-codingplan-crypto/` 那条规则只覆盖
# workspace 里被覆盖后的目录,覆盖不到仓库根下这份 clone。
overlay/
scripts/build-official.sh
build-official.sh
build-official-vscode.sh
build-official-jetbrains.sh

# git worktrees
.worktrees/

extensions/vscode/webview/webview.css
extensions/vscode/webview/webview.css.map
extensions/vscode/webview/webview.js
extensions/vscode/webview/webview.js.map
.hooks.json
extensions/jetbrains/.spec_docs
# 本地评测脚手架(A/B 对比脚本、日志、测试仓),不入库
.aacr-eval/
.superpowers/

.liftoff/

# Codex 子代理在项目目录生成的运行时目录(external subagent driver)
.codex/

# Android 构建产物。`jniLibs/` 里的 .so 由 scripts/build-android.sh 生成,
# 和 webui/dist 不同:它来自本机 NDK 的一次构建,按 ABI 数十 MB,不入库。
# 主应用与每个 provider 工程（android-tools、android-zig）都适用:
# Gradle 缓存、build/ 产出与 jniLibs 下的 .so 都是本机构建产物。
android*/.gradle/
android*/build/
android*/app/build/
android*/local.properties
android*/app/src/main/jniLibs/*/*.so

# 本地 Android SDK/NDK 安装(scripts/build-android.sh 的查找目标之一)。
# 只为让本机构建可复现,体积以 GB 计,不入库。
.android-sdk/

# 插件构建输入：第三方源码包与合并源码由脚本按需下载，体积数 MB 且可重现，不入库。
# 取法见 docs/plugin-ecosystem.md 的「构建输入从哪来」。
quickjs.tar.xz
freetype-*.tar.gz
lsqlite3-master.tar.gz
sqlite-amalgamation.zip
sqlite3.c
sqlite3.h

# helper APK 里的 zig 二进制由工具链复制而来，135 MB，不入库（同主 APK 的 jniLibs 规则）。
android-tools/app/src/main/jniLibs/*/*.so

# adb 调试用的端口/令牌暂存（有值时含设备 token），只留在本机。
.addr

# 编辑器个人工作目录
.trae/
