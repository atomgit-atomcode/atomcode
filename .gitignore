# Build
/target
/runs
/eval/runs

# SWE-bench dataset cache and repo bare clones — runtime artifacts, not source.
/eval/swebench/cache/*
!/eval/swebench/cache/.gitkeep

# Git worktrees (used by superpowers:using-git-worktrees)
/.worktrees/

# OS
.DS_Store
Thumbs.db

# Python (dev scripts)
__pycache__/
*.pyc
/venv/

# Web (separate frontend, not part of core)
/web/

# Node
node_modules/
package-lock.json

# Temp / WIP files
site/index-new.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# Config with secrets
config.toml

# Logs
/datalog/

# Local docs (not pushed to remote)
/doc/
backend.log
.venv-swebench/

# AtomCode local data (graph cache, etc.)
.atomcode/
