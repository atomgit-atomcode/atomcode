diff --git a/packages/OpenComputerUseKit/Tests/DesktopLeaseSmoke/main.swift b/packages/OpenComputerUseKit/Tests/DesktopLeaseSmoke/main.swift
new file mode 100644
index 0000000..b7a6ef3
--- /dev/null
+++ b/packages/OpenComputerUseKit/Tests/DesktopLeaseSmoke/main.swift
@@ -0,0 +1,166 @@
+import Foundation
+import AppKit
+import ApplicationServices
+@testable import OpenComputerUseKit
+
+struct LeaseSmokeFailure: Error {
+    let message: String
+}
+func require(_ condition: Bool, _ message: String) throws {
+    if !condition { throw LeaseSmokeFailure(message: message) }
+}
+
+// Synthetic observation metadata exercises the actual production cache gate;
+// no accessibility, screen capture, application query or input is requested.
+let service = ComputerUseService()
+let bounds = CGRect(x: 0, y: 0, width: 200, height: 100)
+let first = service.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                           screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(first != nil, "a synthetic observation must have an identity")
+try service.checkScreenshotID(first, windowID: 7)
+service.clearTurnObservations()
+var refused = false
+do { try service.checkScreenshotID(first, windowID: 7) } catch { refused = true }
+try require(refused, "release must invalidate the old observation")
+let next = service.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                          screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(first != next, "a released turn must not reissue old screenshot identities")
+try service.checkScreenshotID(next, windowID: 7)
+refused = false
+do { try service.checkScreenshotID(first, windowID: 7) } catch { refused = true }
+try require(refused, "the prior identity stays stale after a new observation")
+
+service.requiresExplicitTurnObservations = true
+refused = false
+do { try service.checkScreenshotID(next, windowID: 7) } catch { refused = true }
+try require(refused, "initial scope negotiation clears legacy observations")
+let scopedA = ComputerUseService()
+let scopedB = ComputerUseService()
+scopedA.requiresExplicitTurnObservations = true
+scopedB.requiresExplicitTurnObservations = true
+let oldConnection = scopedA.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                                  screenshotPixelSize: CGSize(width: 200, height: 100))
+let newConnection = scopedB.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                                  screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(oldConnection != newConnection, "fresh connections must not reissue the prior connection's first screenshot id")
+try scopedB.checkScreenshotID(newConnection, windowID: 7)
+refused = false
+do { try scopedB.checkScreenshotID(oldConnection, windowID: 7) } catch { refused = true }
+try require(refused, "a previous connection's screenshot stays stale after fresh observation")
+var freshObservationRequired = false
+do {
+    _ = try service.click(app: "atomcode-absent-\(UUID().uuidString)", elementIndex: "0",
+                          x: nil, y: nil, clickCount: 1, mouseButton: "left", clickMethod: .accessibility)
+} catch ComputerUseError.message(let message) {
+    freshObservationRequired = message.hasPrefix("No app state is available for this turn.")
+}
+try require(freshObservationRequired, "scoped legacy app actions must not silently refresh and use stale indices")
+
+let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ocu-lease-smoke-\(UUID().uuidString)")
+let previous = ProcessInfo.processInfo.environment["OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY"]
+setenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY", directory.path, 1)
+defer {
+    if let previous { setenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY", previous, 1) }
+    else { unsetenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY") }
+}
+let a = DesktopTurnLease()
+let b = DesktopTurnLease()
+try a.acquire(owner: "scope-a")
+try a.acquire(owner: "scope-a")
+try a.require(owner: "scope-a")
+refused = false
+do { try b.acquire(owner: "scope-b") } catch { refused = true }
+try require(refused, "another object in the same process cannot bypass the OS lease")
+refused = false
+do { try a.release(owner: "stale-scope") } catch { refused = true }
+try require(refused, "a stale owner cannot release a live scope")
+try a.require(owner: "scope-a")
+try require(try a.release(owner: "scope-a"), "matching release must succeed")
+try b.acquire(owner: "scope-b")
+try b.require(owner: "scope-b")
+try require(try b.release(owner: "scope-b"), "next owner must release independently")
+// On failure preserve the private fixture for diagnosis; never unlink a lock
+// that is still owned. Both test leases are released before successful cleanup.
+try FileManager.default.removeItem(at: directory)
+print("Passed native cache/identity and in-process lease smoke; no GUI actions dispatched.")
+
+// Scope decisions use synthetic identities. No application state or GUI input.
+let scopeKey = ApplicationScope.environmentKey
+let absentScope = try ApplicationScope(environment: [:])
+try require(absentScope.permits(nil), "unconfigured scope preserves legacy unknown identities")
+let emptyScope = try ApplicationScope(environment: [scopeKey: "[]"])
+try require(emptyScope.deniesAll && !emptyScope.permits(nil) && !emptyScope.permits("com.example.allowed"), "empty scope denies every app")
+let allowScope = try ApplicationScope(environment: [scopeKey: "[\"com.example.Allowed\"]"])
+try require(allowScope.permits("COM.EXAMPLE.ALLOWED") && !allowScope.permits("com.example.allowed.other"), "bundle matching is exact and normalized")
+for invalid in ["", "{}", "null", "[1]", "[true]", "[\"*\"]", "[\"com..app\"]", "[\" com.example.app\"]", "[\"com.example/app\"]", String(repeating: " ", count: 65537)] {
+    var denied = false
+    do { _ = try ApplicationScope(environment: [scopeKey: invalid]) } catch { denied = true }
+    try require(denied, "malformed application policy must fail closed")
+}
+var displayDenied = false
+do { try allowScope.requireUnrestrictedDisplay() } catch { displayDenied = true }
+try require(displayDenied, "scoped requests cannot capture unrelated apps on a display")
+try require(!globalPointerFallbacksEnabled(environment: [scopeKey: "[]", "OPEN_COMPUTER_USE_ALLOW_GLOBAL_POINTER_FALLBACKS": "1"]), "app scope overrides global pointer opt-in")
+let previousScope = ProcessInfo.processInfo.environment[scopeKey]
+setenv(scopeKey, "[\"com.example.allowed\",\"com.1password.1password\"]", 1)
+try require(!AppSafetyPolicy.isBlocked(bundleIdentifier: "com.example.allowed"), "explicitly allowed app remains available")
+try require(AppSafetyPolicy.isBlocked(bundleIdentifier: "com.1password.1password"), "scope cannot override the existing password-manager deny policy")
+try require(AppSafetyPolicy.isBlocked(bundleIdentifier: nil), "unknown resolved bundle is denied when scoped")
+setenv(scopeKey, "[]", 1)
+var tightened = false
+do { try AppSafetyPolicy.requireAllowed(bundleIdentifier: "com.example.allowed") } catch { tightened = true }
+try require(tightened, "a previously allowed cached identity is checked against the current scope")
+let scopedService = ComputerUseService()
+try require(scopedService.listApps().asDictionary["isError"] as? Bool != true, "empty app catalog is not a permission grant")
+var captureDenied = false
+do { _ = try scopedService.captureDisplay(displayID: nil) } catch { captureDenied = true }
+try require(captureDenied, "service refuses full display capture before invoking capture API")
+let emptyApps = scopedService.listApps().asDictionary["content"] as? [[String: Any]]
+try require(emptyApps?.first?["text"] as? String == "", "deny-all catalog does not leak app metadata")
+let emptyWindows = try scopedService.listWindows().asDictionary["content"] as? [[String: Any]]
+try require(emptyWindows?.first?["text"] as? String == "[]", "deny-all window catalog stays empty")
+setenv(scopeKey, "[\"com.example.allowed\"]", 1)
+let ownProcess = NSRunningApplication.current
+let entry = CGWindowEntry(windowID: 777, ownerPID: getpid(), layer: 0, bounds: bounds, title: "synthetic", frontToBackIndex: 0)
+for identifier: String? in [nil, "com.example.denied", "com.example.allowed"] {
+    let descriptor = RunningAppDescriptor(name: "synthetic", bundleIdentifier: identifier, pid: getpid(), runningApplication: ownProcess)
+    var identityRead = false
+    var denied = false
+    do {
+        _ = try WindowDirectory.resolve(id: 777, entries: [entry], runningApps: [descriptor], identity: { _, _ in
+            identityRead = true
+            return .confirmed
+        })
+    } catch {
+        denied = true
+        try require(!String(describing: error).contains("com.example.denied"), "refusal cannot disclose an unallowed resolved identity")
+    }
+    let permitted = identifier == "com.example.allowed"
+    try require(identityRead == permitted && denied != permitted, "resolved identity is enforced before any AX liveness read")
+}
+let cachedApp = RunningAppDescriptor(name: "synthetic", bundleIdentifier: "com.example.allowed", pid: getpid(), runningApplication: ownProcess)
+let cachedSnapshot = AppSnapshot(app: cachedApp, windowTitle: nil, windowBounds: bounds,
+    targetWindowID: 777, targetWindowLayer: 0, screenshotPNGData: nil, mode: .accessibility,
+    treeLines: [], focusedSummary: nil, focusedElement: nil, selectedText: nil, elements: [:])
+scopedService.cacheWindowSnapshot(cachedSnapshot, windowID: 777)
+_ = try scopedService.windowSnapshot(for: 777)
+setenv(scopeKey, "[]", 1)
+var staleScopeDenied = false
+do { _ = try scopedService.windowSnapshot(for: 777) } catch { staleScopeDenied = true }
+try require(staleScopeDenied, "the actual cached snapshot reader rejects tightened app scope")
+if let previousScope { setenv(scopeKey, previousScope, 1) } else { unsetenv(scopeKey) }
+print("Passed native application-scope parsing/identity/deny/cache/global-capture checks; no GUI actions.")
+
+// Pure production-result classification: no AX requests or GUI effects.
+try require(try knownAccessibilityActionResult(.success, previousSuccesses: 0), "successful action remains successful")
+for code: AXError in [.actionUnsupported, .attributeUnsupported, .illegalArgument] {
+    try require(try !knownAccessibilityActionResult(code, previousSuccesses: 0), "definite first-action refusal may fall back")
+    var refused = false
+    do { _ = try knownAccessibilityActionResult(code, previousSuccesses: 1) } catch { refused = true }
+    try require(refused, "partial multi-click cannot fall back and repeat prior effects")
+}
+for code: AXError in [.cannotComplete, .failure, .noValue, .invalidUIElement] {
+    var refused = false
+    do { _ = try knownAccessibilityActionResult(code, previousSuccesses: 0) } catch { refused = true }
+    try require(refused, "unknown issued action must not trigger another action")
+}
diff --git a/tests/AppAgentNamespaceSmoke/main.swift b/tests/AppAgentNamespaceSmoke/main.swift
new file mode 100644
index 0000000..047d64b
--- /dev/null
+++ b/tests/AppAgentNamespaceSmoke/main.swift
@@ -0,0 +1,146 @@
+import Darwin
+import Foundation
+
+func check(_ ok: @autoclosure () -> Bool, _ message: String) {
+    precondition(ok(), message)
+}
+func refused(_ message: String, _ action: () throws -> Void) {
+    do { try action(); fatalError("expected refusal: \(message)") }
+    catch { }
+}
+func socketAt(_ path: String, listening: Bool = false) throws -> Int32 {
+    let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+    guard fd >= 0 else { throw AppAgentNamespaceError("socket") }
+    var ok = false
+    defer { if !ok { close(fd) } }
+    var address = try AppAgentNamespace.address(path)
+    let result = withUnsafePointer(to: &address) { pointer in
+        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+            bind(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size))
+        }
+    }
+    guard result == 0, chmod(path, mode_t(0o600)) == 0 else { throw AppAgentNamespaceError("bind") }
+    if listening && listen(fd, 16) != 0 { throw AppAgentNamespaceError("listen") }
+    ok = true
+    return fd
+}
+func inode(_ path: String) -> ino_t {
+    var info = stat()
+    precondition(lstat(path, &info) == 0)
+    return info.st_ino
+}
+func fdCount() -> Int { (0..<1024).filter { fcntl(Int32($0), F_GETFD) != -1 }.count }
+
+if CommandLine.arguments.count == 3 && CommandLine.arguments[1] == "--stale-owner" {
+    let binding = try AppAgentSocketLease(path: CommandLine.arguments[2])
+    let fd = try socketAt(CommandLine.arguments[2], listening: true)
+    try binding.recordBoundSocket()
+    // Exercise actual process death without running normal inode cleanup.
+    withExtendedLifetime((binding, fd)) { _exit(0) }
+}
+
+let root = "/tmp/ac-ocu-smoke-\(getpid())"
+try FileManager.default.createDirectory(atPath: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+defer { try? FileManager.default.removeItem(atPath: root) }
+let path = root + "/agent.sock"
+var lease: AppAgentSocketLease? = try AppAgentSocketLease(path: path)
+let lockInode = inode(path + ".lock")
+refused("another listener cannot take the same namespace even before bind") { _ = try AppAgentSocketLease(path: path) }
+lease = nil
+lease = try AppAgentSocketLease(path: path)
+check(inode(path + ".lock") == lockInode, "lifetime lock inode must never be replaced")
+lease = nil
+
+let staleOwner = Process()
+staleOwner.executableURL = URL(fileURLWithPath: CommandLine.arguments[0])
+staleOwner.arguments = ["--stale-owner", path]
+try staleOwner.run()
+staleOwner.waitUntilExit()
+check(staleOwner.terminationStatus == 0, "owned child published a stale socket and exited")
+lease = try AppAgentSocketLease(path: path)
+check(!FileManager.default.fileExists(atPath: path), "checked stale socket is reclaimed under lifetime lock")
+lease = nil
+// An orphan without the listener's recorded ownership is not auto-reclaimed.
+let unknown = try socketAt(path)
+close(unknown)
+refused("unverifiable orphan must be preserved") { _ = try AppAgentSocketLease(path: path) }
+unlink(path)
+let sentinel = try socketAt(path, listening: true)
+let sentinelInode = inode(path)
+refused("active nonparticipating listener is protected too") { _ = try AppAgentSocketLease(path: path) }
+check(inode(path) == sentinelInode, "live sentinel socket was untouched")
+close(sentinel)
+unlink(path)
+
+lease = try AppAgentSocketLease(path: path)
+let owned = try socketAt(path, listening: true)
+try lease!.recordBoundSocket()
+unlink(path)
+let replacement = try socketAt(path, listening: true)
+let replacementInode = inode(path)
+lease!.removeOwnedSocket()
+check(inode(path) == replacementInode, "old cleanup cannot unlink a replacement inode")
+lease = nil
+close(owned)
+close(replacement)
+unlink(path)
+lease = try AppAgentSocketLease(path: path)
+let own = try socketAt(path)
+try lease!.recordBoundSocket()
+lease!.removeOwnedSocket()
+check(!FileManager.default.fileExists(atPath: path), "owned cleanup removes its filesystem socket")
+close(own)
+lease = nil
+check(inode(path + ".lock") == lockInode, "cleanup retains the lock file")
+
+try Data("unrelated".utf8).write(to: URL(fileURLWithPath: path))
+refused("regular file is never unlinked as a socket") { _ = try AppAgentSocketLease(path: path) }
+let unrelated = try String(contentsOfFile: path, encoding: .utf8)
+check(unrelated == "unrelated", "unrelated file preserved")
+try FileManager.default.removeItem(atPath: path)
+try FileManager.default.createSymbolicLink(atPath: path, withDestinationPath: "elsewhere")
+refused("symlink socket") { _ = try AppAgentSocketLease(path: path) }
+try FileManager.default.removeItem(atPath: path)
+let unsafe = root + "/unsafe"
+try FileManager.default.createDirectory(atPath: unsafe, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o755])
+refused("unsafe parent") { _ = try AppAgentSocketLease(path: unsafe + "/a.sock") }
+let alias = root + "/alias"
+try FileManager.default.createSymbolicLink(atPath: alias, withDestinationPath: root)
+refused("symlink parent") { _ = try AppAgentSocketLease(path: alias + "/a.sock") }
+refused("relative path") { _ = try AppAgentSocketLease(path: "relative.sock") }
+refused("overlong path") { _ = try AppAgentSocketLease(path: root + "/" + String(repeating: "a", count: 110)) }
+let badLockPath = root + "/bad.sock"
+try FileManager.default.createSymbolicLink(atPath: badLockPath + ".lock", withDestinationPath: path + ".lock")
+let descriptors = fdCount()
+for _ in 0..<20 {
+    refused("symlink lock") { _ = try AppAgentSocketLease(path: badLockPath) }
+}
+check(fdCount() == descriptors, "rejected lock acquisitions do not leak descriptors")
+try FileManager.default.removeItem(atPath: badLockPath + ".lock")
+try FileManager.default.linkItem(atPath: path + ".lock", toPath: badLockPath + ".lock")
+refused("hardlinked lock") { _ = try AppAgentSocketLease(path: badLockPath) }
+try FileManager.default.removeItem(atPath: badLockPath + ".lock")
+
+func app(_ name: String, marker: String? = "1") throws -> URL {
+    let url = URL(fileURLWithPath: root).appendingPathComponent(name + ".app")
+    let macOS = url.appendingPathComponent("Contents/MacOS")
+    try FileManager.default.createDirectory(at: macOS, withIntermediateDirectories: true)
+    var info: [String: Any] = ["CFBundleIdentifier": "com.ifuryst.opencomputeruse.dev", "CFBundleExecutable": "test", "CFBundlePackageType": "APPL"]
+    if let marker { info["AtomCodeDesktopLeaseProtocol"] = marker }
+    try PropertyListSerialization.data(fromPropertyList: info, format: .xml, options: 0).write(to: url.appendingPathComponent("Contents/Info.plist"))
+    try Data("binary-a".utf8).write(to: macOS.appendingPathComponent("test"))
+    chmod(macOS.appendingPathComponent("test").path, 0o700)
+    return url
+}
+let first = try app("first")
+let firstPath = try AppAgentNamespace.forApp(first).path
+let canonicalFirst = URL(fileURLWithPath: try AppAgentNamespace.canonicalPath(first))
+let canonicalNamespace = try AppAgentNamespace.forApp(canonicalFirst).path
+check(firstPath == canonicalNamespace, "filesystem aliases select the same namespace")
+let otherPath = try AppAgentNamespace.forApp(app("other")).path
+check(firstPath != otherPath, "different bundles have different namespaces")
+try Data("binary-b".utf8).write(to: first.appendingPathComponent("Contents/MacOS/test"))
+let changedPath = try AppAgentNamespace.forApp(first).path
+check(firstPath != changedPath, "changed binary has a new namespace")
+refused("ordinary dev App without the protocol marker") { _ = try AppAgentNamespace.forApp(app("unmarked", marker: nil)) }
+print("App-agent namespace smoke passed: lock ownership, stale/live sockets, inode cleanup, file defenses, namespaces; GUI actions=0")
