diff --git a/apps/OpenComputerUse/Sources/OpenComputerUse/AppAgentNamespace.swift b/apps/OpenComputerUse/Sources/OpenComputerUse/AppAgentNamespace.swift
new file mode 100644
index 0000000..abaa5a8
--- /dev/null
+++ b/apps/OpenComputerUse/Sources/OpenComputerUse/AppAgentNamespace.swift
@@ -0,0 +1,208 @@
+import CryptoKit
+import Darwin
+import Foundation
+
+struct AppAgentNamespaceError: LocalizedError {
+    let errorDescription: String?
+    init(_ message: String) { errorDescription = message }
+}
+
+/// A private, variant/binary-specific socket. This is separate from the desktop
+/// turn lock: idle helpers do not reserve the desktop.
+struct AppAgentNamespace {
+    let path: String
+
+    static func digest(of executable: URL) throws -> String {
+        let file = try FileHandle(forReadingFrom: executable)
+        defer { try? file.close() }
+        var hash = SHA256()
+        while let data = try file.read(upToCount: 65536), !data.isEmpty {
+            hash.update(data: data)
+        }
+        return hash.finalize().map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func canonicalPath(_ url: URL) throws -> String {
+        guard let resolved = realpath(url.path, nil) else {
+            throw AppAgentNamespaceError("Cannot resolve the exact App path.")
+        }
+        defer { free(resolved) }
+        return String(cString: resolved)
+    }
+
+    static func forApp(_ app: URL) throws -> Self {
+        guard let bundle = Bundle(url: app),
+              bundle.bundleIdentifier == "com.ifuryst.opencomputeruse.dev",
+              bundle.object(forInfoDictionaryKey: "AtomCodeDesktopLeaseProtocol") as? String == "1",
+              let executable = bundle.executableURL else {
+            throw AppAgentNamespaceError("Use the isolated AtomCode Lease development App, not an installed release App or raw binary.")
+        }
+        let identity = try canonicalPath(app) + "\0" + digest(of: executable)
+        let hash = SHA256.hash(data: Data(identity.utf8)).map { String(format: "%02x", $0) }.joined()
+        let directory = "/tmp/atomcode-ocu-agent-\(getuid())"
+        try prepareDirectory(directory)
+        return Self(path: directory + "/" + hash.prefix(32) + ".sock")
+    }
+
+    static func prepareDirectory(_ directory: String) throws {
+        guard directory.hasPrefix("/"), !directory.utf8.contains(0) else {
+            throw AppAgentNamespaceError("App-agent directory must be an absolute local path.")
+        }
+        if mkdir(directory, mode_t(0o700)) != 0 && errno != EEXIST {
+            throw AppAgentNamespaceError("Cannot create the private App-agent directory.")
+        }
+        var info = stat()
+        guard lstat(directory, &info) == 0,
+              info.st_mode & mode_t(S_IFMT) == mode_t(S_IFDIR),
+              info.st_uid == getuid(), info.st_mode & mode_t(0o077) == 0 else {
+            throw AppAgentNamespaceError("App-agent directory must be private, owned by this user, and not a symlink.")
+        }
+    }
+
+    /// No connection may follow an unexpected socket/symlink into another App.
+    func validateSocketIfPresent() throws {
+        _ = try Self.socketInfo(path)
+    }
+
+    static func socketInfo(_ path: String) throws -> stat? {
+        guard path.hasPrefix("/"), !path.utf8.contains(0),
+              path.utf8.count < MemoryLayout.size(ofValue: sockaddr_un().sun_path) else {
+            throw AppAgentNamespaceError("Invalid or too-long App-agent socket path.")
+        }
+        var info = stat()
+        if lstat(path, &info) != 0 {
+            if errno == ENOENT { return nil }
+            throw AppAgentNamespaceError("Cannot inspect the App-agent socket.")
+        }
+        guard info.st_mode & mode_t(S_IFMT) == mode_t(S_IFSOCK),
+              info.st_uid == getuid(), info.st_mode & mode_t(0o077) == 0,
+              info.st_nlink == 1 else {
+            throw AppAgentNamespaceError("App-agent socket must be private, owned by this user, and not a symlink.")
+        }
+        return info
+    }
+
+    static func address(_ path: String) throws -> sockaddr_un {
+        guard path.hasPrefix("/"), !path.utf8.contains(0) else {
+            throw AppAgentNamespaceError("Invalid App-agent socket path.")
+        }
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        let bytes = Array(path.utf8)
+        let capacity = MemoryLayout.size(ofValue: address.sun_path)
+        guard bytes.count < capacity else { throw AppAgentNamespaceError("App-agent socket path is too long.") }
+        withUnsafeMutablePointer(to: &address.sun_path) { pointer in
+            pointer.withMemoryRebound(to: CChar.self, capacity: capacity) { buffer in
+                for i in 0..<bytes.count { buffer[i] = CChar(bitPattern: bytes[i]) }
+                buffer[bytes.count] = 0
+            }
+        }
+        return address
+    }
+}
+
+/// Held by the actual listener, not proxies. Never unlinks a live listener or a
+/// lock file. Only an acquired lifetime lock can reclaim a checked stale socket.
+final class AppAgentSocketLease {
+    let path: String
+    private let lockFD: Int32
+    private var bound: stat?
+
+    init(path: String) throws {
+        let directory = (path as NSString).deletingLastPathComponent
+        try AppAgentNamespace.prepareDirectory(directory)
+        _ = try AppAgentNamespace.address(path)
+        let fd = open(path + ".lock", O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, mode_t(0o600))
+        guard fd >= 0 else { throw AppAgentNamespaceError("Cannot open the private App-agent lifetime lock.") }
+        var success = false
+        defer { if !success { close(fd) } }
+        var info = stat()
+        guard fstat(fd, &info) == 0, info.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
+              info.st_uid == getuid(), info.st_mode & mode_t(0o077) == 0, info.st_nlink == 1 else {
+            throw AppAgentNamespaceError("App-agent lifetime lock must be a private regular file owned by this user.")
+        }
+        guard flock(fd, LOCK_EX | LOCK_NB) == 0 else {
+            throw AppAgentNamespaceError("This App-agent namespace is already occupied; its listener was not replaced.")
+        }
+        if let stale = try AppAgentNamespace.socketInfo(path) {
+            // ECONNREFUSED is not proof of death: macOS can return it for a
+            // live Unix listener with a full backlog. Reclaim only the inode
+            // recorded by a listener whose process is provably gone.
+            guard try Self.recordedOwnerIsDead(fd: fd, socket: stale) else {
+                throw AppAgentNamespaceError("App-agent socket has no verifiable dead owner; the existing listener was left untouched.")
+            }
+            guard let current = try AppAgentNamespace.socketInfo(path),
+                  current.st_dev == stale.st_dev, current.st_ino == stale.st_ino else {
+                throw AppAgentNamespaceError("App-agent socket changed during stale recovery.")
+            }
+            guard unlink(path) == 0 else { throw AppAgentNamespaceError("Cannot reclaim the stale App-agent socket.") }
+        }
+        // Until recordBoundSocket completes, this owner has not published a
+        // listener. Never let an older record authorize reclaiming a new path.
+        guard ftruncate(fd, 0) == 0 else { throw AppAgentNamespaceError("Cannot clear the previous listener record.") }
+        self.path = path
+        self.lockFD = fd
+        success = true
+    }
+
+    private static func recordedOwnerIsDead(fd: Int32, socket: stat) throws -> Bool {
+        var file = stat()
+        guard fstat(fd, &file) == 0, file.st_size > 0, file.st_size <= 4096 else { return false }
+        var bytes = [UInt8](repeating: 0, count: Int(file.st_size))
+        let count = bytes.withUnsafeMutableBytes { buffer in
+            pread(fd, buffer.baseAddress, buffer.count, 0)
+        }
+        guard count == bytes.count,
+              let object = try? JSONSerialization.jsonObject(with: Data(bytes)) as? [String: String],
+              object["version"] == "1", object["device"] == String(socket.st_dev),
+              object["inode"] == String(socket.st_ino),
+              let rawPID = object["pid"], let pid = Int32(rawPID), pid > 0 else { return false }
+        // A reused PID is conservatively considered live. EPERM/unknown is
+        // also occupied, never permission to remove somebody else's socket.
+        return kill(pid, 0) == -1 && errno == ESRCH
+    }
+
+    /// Capture the filesystem socket identity immediately after bind, never
+    /// fstat(socketFD): that descriptor need not have the pathname's inode.
+    func recordBoundSocket() throws {
+        var info = stat()
+        guard lstat(path, &info) == 0,
+              info.st_mode & mode_t(S_IFMT) == mode_t(S_IFSOCK), info.st_uid == getuid() else {
+            throw AppAgentNamespaceError("Cannot identify the newly bound App-agent socket.")
+        }
+        bound = info
+        let record = ["version": "1", "pid": String(getpid()),
+                      "device": String(info.st_dev), "inode": String(info.st_ino)]
+        let data = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
+        guard ftruncate(lockFD, 0) == 0, lseek(lockFD, 0, SEEK_SET) >= 0 else {
+            throw AppAgentNamespaceError("Cannot prepare the App-agent listener record.")
+        }
+        try data.withUnsafeBytes { buffer in
+            var offset = 0
+            while offset < buffer.count {
+                let count = write(lockFD, buffer.baseAddress!.advanced(by: offset), buffer.count - offset)
+                if count < 0 && errno == EINTR { continue }
+                guard count > 0 else { throw AppAgentNamespaceError("Cannot record the App-agent listener identity.") }
+                offset += count
+            }
+        }
+        guard fsync(lockFD) == 0 else { throw AppAgentNamespaceError("Cannot commit the App-agent listener record.") }
+    }
+
+    func removeOwnedSocket() {
+        guard let bound else { return }
+        var current = stat()
+        if lstat(path, &current) == 0,
+           current.st_mode & mode_t(S_IFMT) == mode_t(S_IFSOCK),
+           current.st_uid == getuid(), current.st_dev == bound.st_dev, current.st_ino == bound.st_ino {
+            _ = unlink(path)
+        }
+        self.bound = nil
+        _ = ftruncate(lockFD, 0)
+    }
+
+    deinit {
+        removeOwnedSocket()
+        close(lockFD)
+    }
+}
