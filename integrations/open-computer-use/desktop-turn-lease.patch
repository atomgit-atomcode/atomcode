diff --git a/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ApplicationScope.swift b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ApplicationScope.swift
new file mode 100644
index 0000000..cfaf729
--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ApplicationScope.swift
@@ -0,0 +1,46 @@
+import Foundation
+
+/// Trusted host configuration, never model arguments. Not an OS sandbox.
+struct ApplicationScope {
+    static let environmentKey = "OPEN_COMPUTER_USE_ALLOWED_BUNDLE_IDS"
+    let allowed: Set<String>?
+    var isRestricted: Bool { allowed != nil }
+    var deniesAll: Bool { allowed?.isEmpty == true }
+
+    init(environment: [String: String]) throws {
+        guard let raw = environment[Self.environmentKey] else { allowed = nil; return }
+        guard raw.utf8.count <= 65536,
+              let ids = try? JSONDecoder().decode([String].self, from: Data(raw.utf8)),
+              ids.count <= 256,
+              ids.allSatisfy(Self.validIdentifier)
+        else {
+            throw ComputerUseError.permissionDenied("Invalid application scope: expected a bounded JSON array of exact bundle IDs.")
+        }
+        allowed = Set(ids.map { $0.lowercased() })
+    }
+
+    static func current() throws -> ApplicationScope {
+        try ApplicationScope(environment: ProcessInfo.processInfo.environment)
+    }
+
+    private static func validIdentifier(_ id: String) -> Bool {
+        let parts = id.split(separator: ".", omittingEmptySubsequences: false)
+        return id.utf8.count <= 255 && parts.count >= 2 && parts.allSatisfy { part in
+            !part.isEmpty && part.utf8.allSatisfy { byte in
+                (65...90).contains(byte) || (97...122).contains(byte) || (48...57).contains(byte) || byte == 45 || byte == 95
+            }
+        }
+    }
+
+    func permits(_ bundleIdentifier: String?) -> Bool {
+        guard let allowed else { return true }
+        guard let bundleIdentifier else { return false }
+        return allowed.contains(bundleIdentifier.lowercased())
+    }
+
+    func requireUnrestrictedDisplay() throws {
+        if isRestricted {
+            throw ComputerUseError.permissionDenied("Application scope forbids full-display capture; observe an allowed window instead.")
+        }
+    }
+}
