new file mode 100644
index 0000000..b57c25e
--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/DesktopTurnLease.swift
@@ -0,0 +1,94 @@
+import Darwin
+import Foundation
+
+/// Cooperative desktop ownership belongs to the executing connection, not its
+/// stdio proxy. In the App agent, connection teardown occurs after accepted
+/// work finishes, even when the proxy disappeared during that work.
+final class DesktopTurnLease {
+    private let mutex = NSLock()
+    private var descriptor: Int32 = -1
+    private var owner: String?
+
+    func acquire(owner requested: String) throws {
+        try validate(requested)
+        mutex.lock()
+        defer { mutex.unlock() }
+        if let owner {
+            guard owner == requested else { throw busy() }
+            return
+        }
+        let directory = ProcessInfo.processInfo.environment["OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY"]
+            ?? "/tmp/open-computer-use-turn-\(getuid())"
+        guard directory.hasPrefix("/"), !directory.utf8.contains(0) else {
+            throw ComputerUseError.message("Desktop lease directory must be an absolute local path.")
+        }
+        if mkdir(directory, mode_t(0o700)) != 0 && errno != EEXIST {
+            throw ComputerUseError.message("Cannot create the private desktop lease directory.")
+        }
+        var directoryInfo = stat()
+        guard lstat(directory, &directoryInfo) == 0,
+              directoryInfo.st_mode & mode_t(S_IFMT) == mode_t(S_IFDIR),
+              directoryInfo.st_uid == getuid(),
+              directoryInfo.st_mode & mode_t(0o077) == 0 else {
+            throw ComputerUseError.message("Desktop lease directory must be private, owned by this user, and not a symlink.")
+        }
+        let path = (directory as NSString).appendingPathComponent("desktop.lock")
+        let fd = open(path, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, mode_t(0o600))
+        guard fd >= 0 else { throw ComputerUseError.message("Cannot open the desktop lease file.") }
+        var fileInfo = stat()
+        guard fstat(fd, &fileInfo) == 0,
+              fileInfo.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
+              fileInfo.st_uid == getuid(),
+              fileInfo.st_mode & mode_t(0o077) == 0,
+              fileInfo.st_nlink == 1 else {
+            close(fd)
+            throw ComputerUseError.message("Desktop lease file must be a private regular file owned by this user.")
+        }
+        guard flock(fd, LOCK_EX | LOCK_NB) == 0 else {
+            let failure = errno
+            close(fd)
+            if failure == EWOULDBLOCK || failure == EAGAIN { throw busy() }
+            throw ComputerUseError.message("Cannot acquire the desktop lease.")
+        }
+        descriptor = fd
+        owner = requested
+    }
+
+    func require(owner requested: String) throws {
+        try validate(requested)
+        mutex.lock()
+        defer { mutex.unlock() }
+        guard owner == requested, descriptor >= 0 else {
+            throw ComputerUseError.message("This desktop call does not own the current turn lease. The host must acquire it before dispatch.")
+        }
+    }
+
+    /// A stale or different owner cannot release an active turn.
+    @discardableResult
+    func release(owner requested: String) throws -> Bool {
+        try validate(requested)
+        mutex.lock()
+        defer { mutex.unlock() }
+        guard let owner else { return false }
+        guard owner == requested else { throw busy() }
+        close(descriptor)
+        descriptor = -1
+        self.owner = nil
+        return true
+    }
+
+    private func validate(_ owner: String) throws {
+        guard !owner.isEmpty, owner.utf8.count <= 512, !owner.utf8.contains(0) else {
+            throw ComputerUseError.message("A bounded, nonempty host turn scope is required.")
+        }
+    }
+
+    private func busy() -> ComputerUseError {
+        .message("Desktop is busy with another turn. Retry after that turn finishes; do not bypass the lease.")
+    }
+
+    deinit {
+        if descriptor >= 0 { close(descriptor) }
+        // Never unlink the lock file: waiters must keep using the same inode.
+    }
+}
