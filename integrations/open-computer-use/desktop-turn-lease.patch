@@ -0,0 +1,83 @@
+import Foundation
+@testable import OpenComputerUseKit
+
+struct LeaseSmokeFailure: Error {
+    let message: String
+}
+func require(_ condition: Bool, _ message: String) throws {
+    if !condition { throw LeaseSmokeFailure(message: message) }
+}
+
+// Synthetic observation metadata exercises the actual production cache gate;
+// no accessibility, screen capture, application query or input is requested.
+let service = ComputerUseService()
+let bounds = CGRect(x: 0, y: 0, width: 200, height: 100)
+let first = service.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                           screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(first != nil, "a synthetic observation must have an identity")
+try service.checkScreenshotID(first, windowID: 7)
+service.clearTurnObservations()
+var refused = false
+do { try service.checkScreenshotID(first, windowID: 7) } catch { refused = true }
+try require(refused, "release must invalidate the old observation")
+let next = service.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                          screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(first != next, "a released turn must not reissue old screenshot identities")
+try service.checkScreenshotID(next, windowID: 7)
+refused = false
+do { try service.checkScreenshotID(first, windowID: 7) } catch { refused = true }
+try require(refused, "the prior identity stays stale after a new observation")
+
+service.requiresExplicitTurnObservations = true
+refused = false
+do { try service.checkScreenshotID(next, windowID: 7) } catch { refused = true }
+try require(refused, "initial scope negotiation clears legacy observations")
+let scopedA = ComputerUseService()
+let scopedB = ComputerUseService()
+scopedA.requiresExplicitTurnObservations = true
+scopedB.requiresExplicitTurnObservations = true
+let oldConnection = scopedA.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                                  screenshotPixelSize: CGSize(width: 200, height: 100))
+let newConnection = scopedB.issueWindowScreenshotID(windowID: 7, hasImage: true, bounds: bounds,
+                                                  screenshotPixelSize: CGSize(width: 200, height: 100))
+try require(oldConnection != newConnection, "fresh connections must not reissue the prior connection's first screenshot id")
+try scopedB.checkScreenshotID(newConnection, windowID: 7)
+refused = false
+do { try scopedB.checkScreenshotID(oldConnection, windowID: 7) } catch { refused = true }
+try require(refused, "a previous connection's screenshot stays stale after fresh observation")
+var freshObservationRequired = false
+do {
+    _ = try service.click(app: "atomcode-absent-\(UUID().uuidString)", elementIndex: "0",
+                          x: nil, y: nil, clickCount: 1, mouseButton: "left", clickMethod: .accessibility)
+} catch ComputerUseError.message(let message) {
+    freshObservationRequired = message.hasPrefix("No app state is available for this turn.")
+}
+try require(freshObservationRequired, "scoped legacy app actions must not silently refresh and use stale indices")
+
+let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ocu-lease-smoke-\(UUID().uuidString)")
+let previous = ProcessInfo.processInfo.environment["OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY"]
+setenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY", directory.path, 1)
+defer {
+    if let previous { setenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY", previous, 1) }
+    else { unsetenv("OPEN_COMPUTER_USE_TURN_LEASE_DIRECTORY") }
+}
+let a = DesktopTurnLease()
+let b = DesktopTurnLease()
+try a.acquire(owner: "scope-a")
+try a.acquire(owner: "scope-a")
+try a.require(owner: "scope-a")
+refused = false
+do { try b.acquire(owner: "scope-b") } catch { refused = true }
+try require(refused, "another object in the same process cannot bypass the OS lease")
+refused = false
+do { try a.release(owner: "stale-scope") } catch { refused = true }
+try require(refused, "a stale owner cannot release a live scope")
+try a.require(owner: "scope-a")
+try require(try a.release(owner: "scope-a"), "matching release must succeed")
+try b.acquire(owner: "scope-b")
+try b.require(owner: "scope-b")
+try require(try b.release(owner: "scope-b"), "next owner must release independently")
+// On failure preserve the private fixture for diagnosis; never unlink a lock
+// that is still owned. Both test leases are released before successful cleanup.
+try FileManager.default.removeItem(at: directory)
+print("Passed native cache/identity and in-process lease smoke; no GUI actions dispatched.")
diff --git a/tests/AppAgentNamespaceSmoke/main.swift b/tests/AppAgentNamespaceSmoke/main.swift
new file mode 100644
index 0000000..047d64b
--- /dev/null
+++ b/tests/AppAgentNamespaceSmoke/main.swift
@@ -0,0 +1,146 @@
+import Darwin
+import Foundation
+
+func check(_ ok: @autoclosure () -> Bool, _ message: String) {
+    precondition(ok(), message)
+}
+func refused(_ message: String, _ action: () throws -> Void) {
+    do { try action(); fatalError("expected refusal: \(message)") }
+    catch { }
+}
+func socketAt(_ path: String, listening: Bool = false) throws -> Int32 {
+    let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+    guard fd >= 0 else { throw AppAgentNamespaceError("socket") }
+    var ok = false
+    defer { if !ok { close(fd) } }
+    var address = try AppAgentNamespace.address(path)
+    let result = withUnsafePointer(to: &address) { pointer in
+        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+            bind(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size))
+        }
+    }
+    guard result == 0, chmod(path, mode_t(0o600)) == 0 else { throw AppAgentNamespaceError("bind") }
+    if listening && listen(fd, 16) != 0 { throw AppAgentNamespaceError("listen") }
+    ok = true
+    return fd
+}
+func inode(_ path: String) -> ino_t {
+    var info = stat()
+    precondition(lstat(path, &info) == 0)
+    return info.st_ino
+}
+func fdCount() -> Int { (0..<1024).filter { fcntl(Int32($0), F_GETFD) != -1 }.count }
+
+if CommandLine.arguments.count == 3 && CommandLine.arguments[1] == "--stale-owner" {
+    let binding = try AppAgentSocketLease(path: CommandLine.arguments[2])
+    let fd = try socketAt(CommandLine.arguments[2], listening: true)
+    try binding.recordBoundSocket()
+    // Exercise actual process death without running normal inode cleanup.
+    withExtendedLifetime((binding, fd)) { _exit(0) }
+}
+
+let root = "/tmp/ac-ocu-smoke-\(getpid())"
+try FileManager.default.createDirectory(atPath: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+defer { try? FileManager.default.removeItem(atPath: root) }
+let path = root + "/agent.sock"
+var lease: AppAgentSocketLease? = try AppAgentSocketLease(path: path)
+let lockInode = inode(path + ".lock")
+refused("another listener cannot take the same namespace even before bind") { _ = try AppAgentSocketLease(path: path) }
+lease = nil
+lease = try AppAgentSocketLease(path: path)
+check(inode(path + ".lock") == lockInode, "lifetime lock inode must never be replaced")
+lease = nil
+
